---
import Layout from '../../layouts/Layout.astro';
import NicheLandingPage from './NicheLandingPage.astro';
import { getCollection } from 'astro:content';
import { ALLOWED_SERVICES, SEO_SERVICES, WEB_DEV_SERVICES, TARGET_CITIES, TARGET_CITIES_98, PRIORITY_CITIES } from "../../../lib/constants";
import { TARGET_REGENCIES_416 } from "../../../lib/regencies";
import { districtSentence } from "../../../lib/districts";
import { cityProfile } from "../../../lib/cityProfiles";
import { NICHE_MAP, NICHE_SLUGS } from "../../../lib/niches";
import { ArrowUpRight, CheckCircle2, MapPin, Star } from "lucide-react";

export const prerender = false;

const { service, location } = Astro.params;
const resolvedService = service as string;
const locationArray = location ? location.split('/') : [];

// ========================================
// CHECK FOR NICHE LANDING PAGES
// URL pattern: /jasa-website-[niche]-[city]
// The [service] param captures the full slug
// ========================================
let nicheMatch = null;
let nicheCitySlug = '';

if (resolvedService.startsWith('jasa-website-')) {
  const remainder = resolvedService.replace('jasa-website-', '');
  // Sort by length descending to match longest niche slugs first (e.g., "klinik-kecantikan" before "klinik")
  const sortedSlugs = [...NICHE_SLUGS].sort((a, b) => b.length - a.length);
  
  for (const nicheSlug of sortedSlugs) {
    if (remainder.startsWith(nicheSlug + '-')) {
      const citySlug = remainder.slice(nicheSlug.length + 1);
      if (TARGET_CITIES_98.includes(citySlug) || TARGET_REGENCIES_416.includes(citySlug)) {
        // Only priority cities get their own page. The rest were doorway pages:
        // identical copy with the city name swapped. Send them to the niche's
        // parent page, which covers the same offer nationally.
        if (!PRIORITY_CITIES.includes(citySlug)) {
          return Astro.redirect(`/jasa-website-${nicheSlug}/`, 301);
        }
        nicheMatch = NICHE_MAP.get(nicheSlug)!;
        nicheCitySlug = citySlug;
        break;
      }
    } else if (remainder === nicheSlug) {
      nicheMatch = NICHE_MAP.get(nicheSlug)!;
      nicheCitySlug = "seluruh-indonesia";
      break;
    }
  }
}

// Niche pages will be rendered conditionally in the template below.
if (!nicheMatch && !ALLOWED_SERVICES.includes(resolvedService)) {
  return Astro.rewrite('/404');
}

// Any location segment must be a real, known place. Without this an unbounded
// number of made-up URLs (/jasa-pembuatan-website/anything) all answered 200 —
// an infinite crawl trap that dilutes the whole domain.
if (!nicheMatch && locationArray.length > 0) {
  const joined = locationArray.join('-');
  const knownPlace =
    TARGET_CITIES.includes(joined) ||
    TARGET_CITIES_98.includes(joined) ||
    TARGET_REGENCIES_416.includes(joined);
  if (!knownPlace) {
    return Astro.rewrite('/404');
  }

  // Same duplicate-content problem as the niche pages: /<service>/<city> bodies
  // are ~99.8% identical across cities. Keep only the priority cities; the rest
  // fold into the service's national page.
  if (!PRIORITY_CITIES.includes(joined)) {
    return Astro.redirect(`/${resolvedService}/`, 301);
  }
}

function formatString(str: string): string {
  return str.replace(/-/g, " ").replace(/\b\w/g, (l) => l.toUpperCase()).replace(/\bSeo\b/g, "SEO");
}
let resolvedServiceName = formatString(resolvedService);
let resolvedLocationName = locationArray.length > 0 ? formatString(locationArray.join(" ")) : "";
let displayLocation = "";

if (locationArray.length > 0) {
  const joinedLocation = locationArray.join("-");
  const allCities = [...new Set([...TARGET_CITIES, ...TARGET_CITIES_98, ...TARGET_REGENCIES_416])].sort((a,b) => b.length - a.length);
  const matchedCity = allCities.find(c => joinedLocation.endsWith(c));

  if (matchedCity && matchedCity !== joinedLocation) {
    const cleanNichePart = joinedLocation.replace(new RegExp(`-?${matchedCity}$`), '');
    resolvedLocationName = formatString(matchedCity);
    resolvedServiceName = `${resolvedServiceName} ${formatString(cleanNichePart)}`;
    displayLocation = ` di ${resolvedLocationName}`;
  } else {
    displayLocation = ` di ${resolvedLocationName}`;
  }
}

const serviceName = resolvedServiceName;
const locationName = resolvedLocationName;

const whatsappNumber = "6282160731800";
const waMessage = `Halo, saya tertarik dengan ${serviceName.toLowerCase()}${displayLocation}. Boleh info lebih lanjut?`;
const waLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waMessage)}`;

const isSeoService = SEO_SERVICES.includes(resolvedService);

// Real district names only. Cities without verified data get no coverage
// section at all, rather than an invented "<City> Pusat/Utara/Selatan" list.
const districtLine = locationArray.length > 0 ? districtSentence(locationArray.join('-')) : null;

// The 14 service slugs are keyword variants of the same two offers, and their
// bodies are ~99% identical — pure self-cannibalisation. Keep them reachable,
// but point every variant's canonical at one primary slug per offer so Google
// consolidates the signals instead of splitting them 7 ways.
const PRIMARY_WEB_DEV_SLUG = 'jasa-pembuatan-website';
const PRIMARY_SEO_SLUG = 'jasa-seo';
const canonicalService = nicheMatch
  ? resolvedService
  : isSeoService
    ? PRIMARY_SEO_SLUG
    : WEB_DEV_SERVICES.includes(resolvedService)
      ? PRIMARY_WEB_DEV_SLUG
      : resolvedService;
const canonicalPath = [canonicalService, ...locationArray].join('/');
const pageCanonicalUrl = `https://rafiq.biz.id/${canonicalPath}/`;
// A variant slug adds nothing to the index; let it pass equity without being indexed.
const pageRobots =
  canonicalService === resolvedService ? 'index, follow' : 'noindex, follow';

// Related internal links: sibling services + relevant blog articles
const siblingServices = (isSeoService ? SEO_SERVICES : WEB_DEV_SERVICES).filter((s) => s !== resolvedService);
const allBlogPosts = await getCollection('blog');
const relatedPosts = allBlogPosts
  .filter((p) => !isSeoService || p.data.tags?.includes('SEO'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// SEO service types & work methodology (used to flesh out topical depth for SEO_SERVICES pages)
const seoServiceTypes = [
  { title: "Technical SEO", desc: "Perbaikan fondasi teknis situs: kecepatan (Core Web Vitals), struktur URL, crawlability, dan indeksasi agar Google bisa merayapi situs Anda tanpa hambatan.", emoji: "⚙️" },
  { title: "On-Page SEO", desc: "Optimasi judul, heading, meta description, internal linking, dan struktur konten pada tiap halaman agar relevan dengan kata kunci incaran.", emoji: "📝" },
  { title: "Off-Page SEO & Backlink", desc: "Membangun profil tautan masuk (backlink) berkualitas dari situs relevan untuk menaikkan otoritas domain secara alami.", emoji: "🔗" },
  { title: "Local SEO / GMB", desc: "Optimasi Google Business Profile, sitasi NAP, dan ulasan agar bisnis Anda tampil di Google Maps dan Local 3-Pack.", emoji: "📍" },
  { title: "Content SEO", desc: "Riset dan penulisan konten yang menjawab search intent pengunjung, sekaligus menargetkan kata kunci long-tail bervolume.", emoji: "📰" },
  { title: "SEO Audit & Riset Kompetitor", desc: "Analisis mendalam posisi Anda saat ini dan celah keyword yang belum digarap kompetitor untuk merumuskan strategi prioritas.", emoji: "🔍" },
];

const seoProcessSteps = [
  { step: "1", title: "Audit Awal", desc: "Analisis teknis, on-page, dan profil backlink situs Anda saat ini untuk menemukan akar masalah ranking." },
  { step: "2", title: "Riset Keyword", desc: "Memetakan kata kunci prioritas berdasarkan volume pencarian, tingkat kesulitan, dan niat komersial." },
  { step: "3", title: "Optimasi On-Page & Teknis", desc: "Perbaikan struktur heading, meta tag, kecepatan halaman, dan schema markup." },
  { step: "4", title: "Konten & Link Building", desc: "Produksi konten pilar serta membangun backlink berkualitas secara bertahap dan aman." },
  { step: "5", title: "Monitoring & Laporan", desc: "Pemantauan posisi kata kunci dan traffic tiap bulan, dituangkan dalam laporan performa yang transparan." },
];

const seoGlossary = [
  { term: "SERP", def: "Search Engine Results Page — halaman hasil pencarian yang ditampilkan Google setelah pengguna mengetik kata kunci." },
  { term: "Backlink", def: "Tautan dari website lain yang mengarah ke situs Anda, salah satu sinyal kepercayaan utama bagi mesin pencari." },
  { term: "Domain Authority (DA)", def: "Skor prediktif yang menggambarkan seberapa besar potensi sebuah domain untuk mendapat ranking tinggi di hasil pencarian." },
  { term: "Keyword Difficulty", def: "Ukuran seberapa sulit sebuah kata kunci untuk menembus halaman pertama, dilihat dari kekuatan kompetitor yang sudah ranking." },
  { term: "Core Web Vitals", def: "Kumpulan metrik teknis Google (LCP, INP, CLS) yang mengukur kecepatan dan kenyamanan pengalaman pengguna pada sebuah halaman." },
  { term: "White Hat vs Black Hat SEO", def: "White Hat mengikuti pedoman resmi Google secara etis dan aman jangka panjang; Black Hat memakai celah atau trik yang berisiko kena penalti." },
  { term: "Local 3-Pack", def: "Tiga hasil bisnis lokal teratas yang ditampilkan Google Maps di bagian atas hasil pencarian untuk query berbasis lokasi." },
];

const seoTestimonials = [
  { name: "Andi Wijaya", role: "Owner Toko Bangunan Makmur Jaya", text: "Sejak audit teknis dan perbaikan struktur konten dijalankan, pencarian yang tadinya tidak pernah muncul perlahan mulai mengarah ke website kami. Leads dari Google jadi lebih rutin masuk tiap minggu." },
  { name: "Dewi Lestari", role: "Marketing Manager, Klinik Kecantikan Radiance", text: "Laporan bulanannya jelas, jadi kami bisa lihat progres posisi kata kunci naik pelan-pelan tapi konsisten. Tim juga responsif setiap kali kami ada pertanyaan teknis." },
  { name: "Rizky Pratama", role: "Founder Startup Logistik Kilat", text: "Kami sempat kesulitan bersaing di halaman pencarian. Setelah perbaikan on-page dan strategi konten dijalankan bertahap, traffic organik mulai naik dan lebih stabil dari bulan ke bulan." },
];

function initials(name: string): string {
  return name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
}

const titlePrefix = serviceName.toLowerCase().startsWith('jasa') ? serviceName : `Jasa ${serviceName}`;

const titleContent = isSeoService 
  ? `${titlePrefix}${displayLocation} | Pakar SEO Profesional Bergaransi` 
  : `${titlePrefix}${displayLocation} | Web Developer Bergaransi`;

const descriptionContent = isSeoService
  ? `Mencari ahli optimasi ranking laman? Kami adalah agensi Jasa SEO Profesional${displayLocation} yang fokus mendominasi kata kunci Google, Bing, & AI Overview. Tingkatkan trafik Anda!`
  : `Mencari jasa pembuatan website${displayLocation}? Kami adalah web developer profesional yang berfokus pada desain web responsif, company profile, dan toko online dengan optimasi SEO tingkat lanjut. Mulai Rp 1.9 Juta.`;

const keywordsList = isSeoService ? [
  `${titlePrefix}`,
  `${serviceName.toLowerCase()}${displayLocation}`,
  "Konsultan SEO",
  "Pakar SEO",
  "Backlink",
  "Optimasi Google",
  "SEO Bergaransi",
  "SEO Murah"
] : [
  `${titlePrefix}`,
  `${serviceName.toLowerCase()}${displayLocation}`,
  "Buat Website Murah",
  "Developer Website",
  "SEO Friendly",
  "Website Bisnis",
  "Pembuatan website"
];

// Content arrays...
const faqListWebDev = [
    {
      q: "Berapa biaya jasa pembuatan website profesional untuk bisnis saya?",
      a: "Harga layanan dari web developer kami sangat kompetitif namun tetap memberikan standar kualitas enterprise. Kami menawarkan paket transparan mulai dari Rp1.900.000 untuk paket pembuatan web UMKM, hingga Rp5.900.000 untuk kelas Corporate Premium dengan fitur e-commerce dan optimasi SEO tingkat lanjut."
    },
    {
      q: "Berapa lama proses pembuatan / pengembangan toko online hingga dapat digunakan?",
      a: "Durasi proses rekayasa desain web (web development) rata-rata memakan waktu singkat antara 3-14 hari kerja. Estimasi ini bisa lebih cepat tergantung pada kelengkapan materi pendukung bisnis Anda, serta kerumitan sistem maupun integrasi custom yang dibutuhkan."
    },
    {
      q: "Apakah website sudah dirancang SEO-Friendly dan gampang ditemukan di pencarian Google, Bing, dan lainnya?",
      a: "Tentu. Semua fondasi website dibangun menggunakan teknik On-Page SEO terstandarisasi, arsitektur Semantic HTML, plus schema markup Data Terstruktur JSON-LD. Kami juga mendaftarkan sitemap web ke Google Search Console dan Bing Webmaster untuk memperkuat dan mempermudah indeksasi oleh robot mesin penelusur."
    },
    {
      q: "Bagaimana optimasi AI Overview (Google SGE & Copilot) dari jasa pembuatan website Anda?",
      a: "Era pencarian sudah beralih ke Search Generative Experience bertenaga AI. Website rancangan kami sudah dikondisikan sangat ramah untuk crawler AI (LLM-friendly), diinjeksi dengan copywriting semantik agar inti halaman mudah ditangkap secara otomatis (indexing) oleh mesin SGE sebagai rekomendasi profil bisnis yang terpercaya."
    },
    {
      q: "Apakah desain konten bersifat Mobile-Friendly (Responsif) di semua platform layar?",
      a: "Pasti! Saat ini mayoritas pengunjung berasal dari smartphone. Kami menerapkan pendekatan desain Mobile-First yang menjamin kecepatan pemuatan (Core Web Vitals) superior, ditambah lagi dengan antarmuka User Experience (UX) yang sangat terorganisir, baik pada ukuran layar desktop besar hingga seukuran saku."
    },
    {
      q: "Lebih baik mana: Memakai template CMS instan atau menyewa Jasa Bikin Web Profesional?",
      a: "Template CMS gratisan sering menyertakan fitur bawaan berat yang memperlambat website (bloat) dan rentan celah keamanan. Sebaliknya dengan pembuat website profesional, strategi rekayasa alur pengunjung sudah dipikirkan matang-matang guna menaikan retensi hingga memperlancar navigasi pemicu klik WhatsApp sebagai prospek konversi."
    },
    {
      q: "Apakah saya harus membayar biaya maintenance hosting atau layanan server tahunan?",
      a: "Tentu. Mesin website selalu memerlukan perpanjangan akses kepemilikan nama domain.com asli Anda serta berlangganan ruang cloud storage server (Web Hosting) yang aktif 24/7. Bersama kami, kompleksitas ini diurus 100% oleh ahli teknis, Anda tak perlu ribet mengurusi downtime, cukup fokus meraup pelanggan bisnis yang berdatangan."
    },
    {
      q: `Apakah ke depannya saya bisa memperbarui informasi layanan untuk ${serviceName} secara manual?`,
      a: "Pasti bisa. Anda tak butuh pengetahuan coding. Terdapat akses control panel admin intuitif untuk mengganti isi teks landing page, foto portofolio, hingga produk. Kalaupun timbul pertanyaan sewaktu penggunaan, prioritas customer support pendamping (live maintenance chat) kami senantiasa siaga dengan instruksi penyelesaian paling mudah di hari kerja."
    }
];

const faqListSEO = [
    {
      q: `Berapa biaya rata-rata untuk Jasa ${serviceName} ini?`,
      a: "Skema harga kami sangat transparan; mulai dari Rp 2.500.000 untuk paket Lokal SEO GMB, Rp 4.000.000 untuk Optimasi SEO Bisnis skala menengah, dan Rp 6.500.000 untuk strategi SEO VIP Enterprise komprehensif yang dirancang menggandakan omzet secara organik."
    },
    {
      q: "Berapa lama waktu yang dibutuhkan hingga website menembus Page 1 Google?",
      a: "SEO adalah proses maraton organik, bukan sekadar lari sprint. Biasanya, pergerakan tren naik (uptarget) mulai terlihat di bulan pertama hingga ketiga. Tentu rentang waktu diukur tergantung pada tingkat kesulitan kompetitor pencarian (keyword difficulty) serta frekuensi penerapan optimasi konten backlink."
    },
    {
      q: "Teknik optimasi SEO apa yang Anda gunakan? Apakah aman?",
      a: "Tentu saja 100% White-Hat SEO murni. Kami menggunakan fondasi perbaikan skor teknikal kecepatan situs (Core Web Vitals), struktur siloing on-page audit, pemasangan skema entitas semantis, juga menyertakan jejaring tautan masuk (High-Authority Backlink) agar jauh dari radar penalti mesin Google."
    },
    {
      q: "Apakah Jasa SEO Anda menyokong kemampuan penelusuran (AI Overview / SGE)?",
      a: "Begitu mendukung. Melalui integrasi Markup Data Skema (Schema-LD JSON) dengan presisi informasi lokal, kapabilitas algoritma Artificial Intelligence LLM akan jauh lebih mudah memahami esensi dari pendaratan situs bisnis. Hal ini membuka kran trafik eksklusif saat mesin merekomendasikan cuplikan web Anda."
    },
    {
      q: "Benarkah Anda memberi kepastian atau jaminan naiknya Traffic Pengunjung?",
      a: "Agensi SEO profesional pantang memberi iming-iming instan yang menyesatkan; tetapi, kami berani menjamin pelaksanaan optimasi (delivered work) kelas premium. Saat kami setujui perbaikan long-tail keywords yang Anda bidik, trafik dipastikan sehat meningkat. Kami pantau performanya dari analitik terverifikasi agar return investasi dapat terlaksana maksimal."
    },
    {
      q: "Apakah saya harus berkontribusi menyiapkan salinan artikel blog promosi sendiri?",
      a: "Sama sekali tak merepotkan bagi klien kami. Konten adalah bagian tak terpisahkan dari ranking. Paket layanan telah menyentuh aspek Content Writing pilar sesuai intensional komersial calon penelusur yang menstimulasi keintiman baca sebelum transaksi ditutup via kontak narahubung konsultasi WhatsApp."
    },
    {
      q: "Mekanisme kerja seperti apa yang dilakukan pada optimasi SEO Lokal Anda?",
      a: "Dalam lanskap Lokal SEO, mesin ingin merekam titik pijakan terdekat pelanggan. Kami menyerbu Google Business Profile (Map) Anda via ulasan sah, serta mendistribusikan kutipan nama-alamat-kontak (NAP) di aneka jejaring vertikal. Tujuannya adalah memborong kotak The Local 3-Pack di posisi paling strategis layar gawai pelanggan kota setempat."
    },
    {
      q: "Bagaimana cara mengetahui bahwa progres Jasa SEO tersebut berjalan lurus?",
      a: "Kami memprioritaskan rasa tenang nasabah di fase apa pun. Tiap peralihan akhir bulan, hasil analisa portofolio ranking pencarian kata kunci diturunkan dalam wujud lampiran terstruktur. Termasuk performansi impresi klik berpandu ketat rekaman Google Search Console."
    }
];

const currentFaqList = isSeoService ? faqListSEO : faqListWebDev;
const currentOffers = isSeoService ? [
    { name: "SEO Lokal", price: "2500000", priceCurrency: "IDR" },
    { name: "SEO Bisnis", price: "4000000", priceCurrency: "IDR" },
    { name: "SEO VIP Enterprise", price: "6500000", priceCurrency: "IDR" },
] : [
    { name: "Paket Starter", price: "1900000", priceCurrency: "IDR" },
    { name: "Paket Pro", price: "3500000", priceCurrency: "IDR" },
    { name: "Paket Premium", price: "5900000", priceCurrency: "IDR" },
];

const founderSchema = {
  "@type": "Person",
  "name": "Rafiq Al Hafizh Adha",
  "jobTitle": isSeoService ? "SEO Specialist" : "Web Developer",
  "url": "https://rafiq.biz.id",
  "sameAs": [
    "https://github.com/raakanaka",
    "https://linkedin.com/in/rafiq-alhafizh-adha"
  ]
};

const pageUrl = `https://rafiq.biz.id/${resolvedService}${locationArray.length > 0 ? '/' + locationArray.join('/') : ''}`;

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "serviceType": serviceName,
        "provider": {
          "@type": "Organization",
          "name": "Rafiq Web Developer",
          "founder": founderSchema,
        },
        "areaServed": locationName
          ? { "@type": "Place", "name": locationName }
          : { "@type": "Country", "name": "Indonesia" },
        "offers": currentOffers.map(o => ({
          "@type": "Offer",
          "name": o.name,
          "price": o.price,
          "priceCurrency": o.priceCurrency
        }))
      },
      {
        "@type": "FAQPage",
        "mainEntity": currentFaqList.map((faq) => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": { "@type": "Answer", "text": faq.a },
        })),
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://rafiq.biz.id" },
          { "@type": "ListItem", "position": 2, "name": serviceName, "item": pageUrl },
        ],
      },
      ...(isSeoService ? [{
        "@type": "DefinedTermSet",
        "name": "Glosarium Istilah SEO",
        "hasDefinedTerm": seoGlossary.map((g) => ({
          "@type": "DefinedTerm",
          "name": g.term,
          "description": g.def,
        })),
      }] : []),
    ],
};
---

{nicheMatch && nicheCitySlug ? (
    <NicheLandingPage niche={nicheMatch} citySlug={nicheCitySlug} />
) : (
<Layout title={titleContent} description={descriptionContent} keywords={keywordsList} canonicalUrl={pageCanonicalUrl} robots={pageRobots}>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    </Fragment>

    <main class="min-h-screen flex flex-col bg-background font-body">
        {/* Navigation placeholder for isolated landing page */}
        <header class="w-full p-6 flex justify-center items-center">
            <a href="/" class="text-xl font-bold font-heading text-foreground" style="text-decoration: none;">
                Rafiq<span class="text-accent-pop">.</span>
            </a>
        </header>

        {/* HERO SECTION */}
        <section class="section pt-6 lg:pt-16 pb-12 lg:pb-24 flex-1 flex flex-col items-center justify-center text-center">
            <div class="max-w-4xl mx-auto px-4">
                <div class="badge-brutal mb-6 mx-auto inline-flex">
                    <span>🎯</span> {isSeoService ? "Spesialis Penakluk Algoritma Pencarian Google" : "Web Developer Spesialis Keuntungan Bisnis"}
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold mb-6 text-foreground leading-tight" style="letter-spacing: -0.02em;">
                    {titlePrefix} <span class="text-accent-pop">{displayLocation}</span>
                </h1>
                <p class="text-lg md:text-xl text-text-secondary mb-10 max-w-2xl mx-auto leading-relaxed">
                    {isSeoService
                        ? "Raih posisi puncak mesin pencarian dengan kepastian teknik optimasi White-hat yang aman. Jadikan profil bisnis Anda raja traffic organik, dominasi visibilitas AI Overview (SGE), dan biarkan kompetitor berjuang hanya jadi penonton di halaman gurem."
                        : "Bukan sekadar website biasa. Kami membangun ekosistem digital (Company Profile, Toko Online, Landing Page) yang dirancang secara saintifik untuk mendominasi Semantic Search, dan mengubah trafik organik menjadi klien potensial."
                    }
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-kirim w-full sm:w-auto text-lg py-4 px-8">
                        Konsultasi Gratis <ArrowUpRight className="ml-2 inline-block" size={20} />
                    </a>
                    <a href="#harga" class="btn-outline-brutal w-full sm:w-auto text-lg py-4 px-8">
                        Lihat Harga
                    </a>
                </div>
            </div>
        </section>

        {/* MENGAPA MEMILIH KAMI */}
        <section class="section" style="background: var(--card-bg);">
            <div class="max-w-6xl mx-auto px-4">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-foreground">
                        Kenapa Bisnis Anda Butuh Layanan Kami?
                    </h2>
